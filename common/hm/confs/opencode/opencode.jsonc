{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/gpt-6-luna",
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@plannotator/opencode@latest",
    "opencode-openai-codex-auth",
    "opencode-antigravity-auth@beta"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "--init",
        "mcr.microsoft.com/playwright/mcp"
      ],
      "enabled": true
    },
    "freehire": {
      "type": "remote",
      "url": "https://freehire.me/api/v1/mcp"
    }
  },
  "agent": {
    "plan": {
      "model": "opencode-go/deepseek-v4-pro",
      "variant": "max"
    },
    "build": {
      "model": "opencode-go/gpt-6-luna",
      "variant": "high"
    },
    "general": {
      "model": "opencode-go/gpt-6-luna",
      "variant": "high"
    },
    "explore": {
      "model": "opencode-go/mimo-v2.6-flash"
    },
    "title": {
      "model": "opencode-go/gpt-6-luna",
      "variant": "none"
    },
    "summary": {
      "model": "opencode-go/gpt-6-luna",
      "variant": "none"
    },
    "compaction": {
      "model": "opencode-go/gpt-6-luna",
      "variant": "low"
    }
  },
  "instructions": [
    "./instructions/explorer.md"
  ],
  "permission": {
    "read": {
      "~/.config/opencode/get-shit-done/*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/get-shit-done/*": "allow"
    }
  }
}