{ config, lib, pkgs, modulesPath, ... }:
{

  # Paused, i need to buy the hardware first, and then i will continue with the configuration
  # The hardware would be an Lenovo ThinkCentre M920q Tiny Desktop or similar, which is a small form factor PC that can be used as a home server.
  # Also this files is a template, the real one is generated by the `nixos-generate-config` command, and it is located in `/etc/nixos/hardware-configuration.nix`.

  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

  boot.initrd.availableKernelModules = [ "ahci" "sd_mod" "sr_mod" "usb_storage" "ehci_pci" "ohci_pci" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/disk/by-label/nixos";
    fsType = "ext4";
  };

  swapDevices = [ ];

  hardware.cpu.amd.updateMicrocode = true;
}
